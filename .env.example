# Copy to .env, fill in, then load it before running terraform:
#   set -a; source .env; set +a
# The TF_VAR_ prefix is how Terraform reads variables from the environment.

# Which cluster to install into (kubectl config get-contexts).
TF_VAR_kube_context=kind-steadmesh

# v0.7 sandbox GitHub access requires a separately provisioned ledger Secret
# in steadmesh-system. Leave empty for the initial platform-only bootstrap;
# follow README step 3 to provision it, set this reference, then reapply.
# Never paste the encryption key into this file or Terraform.
TF_VAR_credential_ledger_secret_name=
TF_VAR_credential_ledger_secret_key=key

# Every agent runs Pi (pi.dev), which has no key of its own. Pi needs an LLM
# to think with: any OpenAI-compatible endpoint (chat completions).
TF_VAR_llm_base_url=https://api.example.com/v1
TF_VAR_llm_model=your-model-name
TF_VAR_llm_api_key=...

# The repository the team works in (owner/name), and a fine-grained personal
# access token for that repository only: Contents, Pull requests and Issues
# read/write.
TF_VAR_github_repo=your-org/your-repo
TF_VAR_github_token=github_pat_...

# The organisation is shown in one file: organisation/organisation.tf.
# It keeps four fixed seats by default. Opt into 3–30 extra engineering peers:
# TF_VAR_pool_enabled=true
# Those peers use the same paid model and can read the same sandbox GitHub
# token as the existing engineers. Review the inline budgets before enabling.
